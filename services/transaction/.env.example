# Runtime
NODE_ENV=development
PORT=3003
SERVICE_NAME=transaction
APP_VERSION=dev
TZ=UTC

# PostgreSQL (local: localhost:5432, Docker Compose: postgres:5432)
DATABASE_URL=postgresql://transaction_user:change_me@localhost:5432/transaction_db

# RabbitMQ (local: localhost:5672, Docker Compose: rabbitmq:5672)
AMQP_URL=amqp://guest:guest@localhost:5672

# JWT JWKS verification (local: localhost:3001, Docker Compose: user:3001)
JWT_ISSUER=mini-bank-user
JWT_AUDIENCE=mini-bank-api
JWT_JWKS_URL=http://localhost:3001/api/v1/auth/jwks

# Account Service internal communication (local: localhost:3002, Docker Compose: account:3002)
ACCOUNT_BASE_URL=http://localhost:3002
ACCOUNT_SERVICE_KEY=change_me_internal_secret

# CORS origin
PUBLIC_ORIGIN=http://localhost:8080
